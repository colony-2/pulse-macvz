diff --git a/internal/controller/controller_test.go b/internal/controller/controller_test.go
index 3c0cd8f..0ae3db8 100644
--- a/internal/controller/controller_test.go
+++ b/internal/controller/controller_test.go
@@ -157,3 +157,35 @@ func TestConfiguredBatchSizeBoundsClaimCount(t *testing.T) {
 func (*accept) GetCapabilities(context.Context) (compute.Capabilities, error) {
 	return compute.Capabilities{}, nil
 }
+
+type maintenanceProvider struct {
+	accept
+	err   error
+	calls int
+}
+
+func (p *maintenanceProvider) Maintain(context.Context) error { p.calls++; return p.err }
+func TestMaintenanceFailureDegradesStatusWithoutBlockingOtherProviders(t *testing.T) {
+	bad := &maintenanceProvider{err: errors.New("private detail")}
+	good := &maintenanceProvider{}
+	reads := 0
+	c := &Controller{Config: &config.Config{Call: time.Second, MaxPages: 1, Targets: []config.Target{{Instance: "db", Tenant: "tenant", JobDB: "https://jobs.test"}}},
+		Providers: map[string]compute.Provider{"tart": bad, "docker": good},
+		Lister:    listFunc(func(context.Context, string, string, []c2j.Route) (c2j.Page, error) { reads++; return c2j.Page{}, nil }),
+		Log:       slog.New(slog.NewTextHandler(io.Discard, nil))}
+	if err := c.Once(t.Context()); err != nil {
+		t.Fatal(err)
+	}
+	status := c.Status()
+	if status.LastSucceeded || status.FailedPasses != 1 || status.ProviderMaintenance["tart"] != "degraded" || status.ProviderMaintenance["docker"] != "ok" || reads != 1 || good.calls != 1 {
+		t.Fatal(status, reads, good.calls)
+	}
+	status.ProviderMaintenance["tart"] = "modified"
+	if c.Status().ProviderMaintenance["tart"] != "degraded" {
+		t.Fatal("mutable status map")
+	}
+	bad.err = nil
+	if err := c.Once(t.Context()); err != nil || !c.Status().LastSucceeded {
+		t.Fatal(err, c.Status())
+	}
+}
